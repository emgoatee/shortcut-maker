# LLM Provider Configuration
# Options: "anthropic" | "openai" | "mock"
LLM_PROVIDER=openai

# OpenAI API Key (required if LLM_PROVIDER=openai)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Specify which OpenAI model to use
# Default: gpt-4o
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# OPENAI_MODEL=gpt-4o

# Anthropic API Key (required if LLM_PROVIDER=anthropic)
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Specify which Claude model to use
# Default: claude-sonnet-4-20250514
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
